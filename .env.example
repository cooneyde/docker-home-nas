# Copy to .env next to the compose file that needs it and fill in the values.
# .env is git-ignored. Never commit real values.

# --- core-services.yml ---
# Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels -> your tunnel -> token
CLOUDFLARE_TUNNEL_TOKEN=

# --- network-monitoring.yml ---
# Generate with: echo "base64:$(openssl rand -base64 32)"
SPEEDTEST_APP_KEY=

# --- immich.yml ---
# Keep these in their own .env (separate folder): immich.yml's env_file passes every
# variable in the file into the Immich containers, so don't mix in the secrets above.
# Docs: https://immich.app/docs/install/environment-variables
UPLOAD_LOCATION=/mnt/appdata/immich/data/uploads
DB_DATA_LOCATION=/mnt/appdata/docker/volumes/immich-app/database
TZ=Europe/Dublin
# Pin to a version (e.g. v3), or use "release" for the latest
IMMICH_VERSION=v3
# Letters and digits only, no special characters or spaces
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
